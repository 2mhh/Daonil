# docker compose 용 환경변수. 복사해서 .env 로 만들고 값을 채운다. .env 는 절대 커밋하지 않는다.

# --- 비밀 값 (강한 값으로) ---
MYSQL_ROOT_PASSWORD=change-me-strong
JWT_SECRET=change-me-at-least-32-characters-long-secret
# 없으면 비워 둔다. AI 추천·챗봇 기능만 동작하지 않는다.
OPENAI_API_KEY=
# 공공데이터포털 인증키 (외부 공고 동기화). 없으면 비워 둔다.
KEAD_API_KEY=

# --- 주소: 브라우저가 접속하는 주소 (서버 공개 IP 또는 도메인) ---
# 로컬에서 먼저 시험할 때
PUBLIC_API_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost
# 서버(VM)에서는 공개 IP 로 바꾼다. 포트까지 정확히 맞아야 한다.
# PUBLIC_API_URL=http://<서버 공개 IP>:8080
# FRONTEND_ORIGIN=http://<서버 공개 IP>

# --- 외부 공고 동기화 스케줄러 (기본 꺼짐. 운영에서만 켠다) ---
KEAD_SYNC_ENABLED=false
APP_JOB_EXPIRY_ENABLED=false
